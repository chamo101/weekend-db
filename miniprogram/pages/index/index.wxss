/* 首页样式 */
.page {
  padding-bottom: 40rpx;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
}
.city-picker {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #e8f5e9;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.loc-icon { font-size: 26rpx; margin-right: 6rpx; }
.city-name { font-size: 28rpx; color: #2e7d32; font-weight: 600; max-width: 180rpx; }
.arrow { font-size: 22rpx; color: #2e7d32; margin-left: 6rpx; }

.search-box {
  flex: 1;
  margin-left: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.search-input { font-size: 26rpx; }

.filter-bar {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}
.filter-item {
  display: inline-block;
  padding: 8rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #607d8b;
  background: #f5f5f5;
}
.filter-item.on {
  background: #2e7d32;
  color: #fff;
}

.stat-line {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: #90a4ae;
}

.company-item .row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.c-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #263238;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row2 { margin-top: 10rpx; }
.c-meta {
  font-size: 24rpx;
  color: #78909c;
  margin-right: 16rpx;
}
.row3 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.leave-txt { font-size: 22rpx; color: #90a4ae; margin-left: 8rpx; }
.c-dist {
  font-size: 24rpx;
  color: #2e7d32;
  font-weight: 600;
}
